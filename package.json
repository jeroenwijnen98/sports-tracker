{
  "name": "sports-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.ts",
    "start": "node server.ts",
    "lint": "oxlint --deny-warnings && comment-width --one-line 100 --skip test/fixtures/",
    "test": "checked-tree run npm run --silent check",
    "check": "npm run typecheck && npm run lint && node --test --test-timeout=300000 'test/**/*.test.js'",
    "typecheck": "tsc -p .",
    "sandcastle": "npx tsx .sandcastle/main.mts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@jeroenwijnen98/standards": "github:jeroenwijnen98/standards#v0.4.1",
    "@oxlint/plugins": "1.86.0",
    "@types/express": "^4.17.25",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.3",
    "oxlint": "1.86.0",
    "typescript": "^7.0.2"
  }
}
