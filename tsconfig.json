{
  // Type-checking only: Node strips the types from backend .ts files and the
  // browser loads public/ as it is, so nothing is ever emitted.
  "extends": "@jeroenwijnen98/standards/tsconfig/node.json",
  "compilerOptions": {
    // public/js runs in the browser, so the DOM types are needed too.
    "lib": ["esnext", "dom", "dom.iterable"],

    // The backend is .ts; the frontend, tests and fixture generator stay .js
    // (JSDoc-typed). Every .js file in `include` is checked, pragma or not.
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true,

    "forceConsistentCasingInFileNames": true
  },
  "include": ["server.ts", "src", "scripts", "public/js", "test", "types"],
  "exclude": ["node_modules", "src/data"]
}
